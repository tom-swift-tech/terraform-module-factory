locals {
  tags = var.tags

  # Defense-in-depth only — never a substitute for Private Link
  public_network_access_enabled = var.allow_public_network_access
}

{% for dep in dependencies %}
module "{{ dep.module_label }}" {
  source = "{{ dep.source }}"
{% if dep.version %}
  version = "{{ dep.version }}"
{% endif %}
  # TODO: wire required inputs for {{ dep.logical_name }}
}

{% endfor %}
