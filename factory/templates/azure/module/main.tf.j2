/**
 * {{ module_name }} — scaffolded by tf-factory
 *
 * Secure baseline defaults:
 * - Public network access disabled unless allow_public_network_access is explicitly true
 * - Private Endpoint composition preferred over public ACL exposure
 * - Required platform tags enforced via variable validation
 */

locals {
  tags = var.tags
  public_network_access_enabled = var.allow_public_network_access
}

{% for dep in dependencies %}
module "{{ dep.module_label }}" {
  source = "{{ dep.source }}"
{% if dep.version_constraint %}
  version = "{{ dep.version_constraint }}"
{% endif %}
{% if dep.module_label == "private_endpoint" %}
  count = var.create_private_endpoint ? 1 : 0
{% endif %}
{% for input_name, input_expr in dep.required_inputs.items() %}
  {{ input_name }} = {{ input_expr }}
{% else %}
  # No required_inputs declared in catalog for {{ dep.logical_name }}
{% endfor %}
}

{% endfor %}
