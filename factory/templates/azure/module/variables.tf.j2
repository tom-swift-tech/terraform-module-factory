{% for v in extra_variables %}
variable "{{ v.name }}" {
  type        = {{ v.type }}
  description = "{{ v.description }}"
{% if v.default is defined %}
  default     = {{ v.default }}
{% endif %}
}

{% endfor %}
variable "tags" {
  type        = map(string)
  description = "Resource tags. Must include: {{ required_tags | join(', ') }}."
  default     = {}

  validation {
    condition = alltrue([
{% for tag in required_tags %}
      contains(keys(var.tags), "{{ tag }}"){% if not loop.last %},{% endif %}
{% endfor %}
    ])
    error_message = "tags must include: {{ required_tags | join(', ') }}."
  }
}
