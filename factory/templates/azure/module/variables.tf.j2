variable "name" {
  type        = string
  description = "Base name for the {{ module_name }} resources (prefer module.naming outputs)."
}

variable "resource_group_name" {
  type        = string
  description = "Resource group that hosts this module."
}

variable "location" {
  type        = string
  description = "Azure region."
}

variable "tags" {
  type        = map(string)
  description = "Resource tags. Must include platform-required keys: {{ required_tags | join(', ') }}."
  default     = {}

  validation {
    condition = alltrue([
{% for tag in required_tags %}
      contains(keys(var.tags), "{{ tag }}"){% if not loop.last %},{% endif %}

{% endfor %}
    ])
    error_message = "tags must include: {{ required_tags | join(', ') }}."
  }
}

variable "allow_public_network_access" {
  type        = bool
  description = "BREAK-GLASS only. Platform baseline requires Private Link; leave false."
  default     = false
}

variable "private_endpoint_subnet_id" {
  type        = string
  description = "Subnet id for the Private Endpoint."
  default     = null
}

variable "private_dns_zone_ids" {
  type        = list(string)
  description = "Private DNS zone ids for the Private Endpoint zone group."
  default     = []
}
